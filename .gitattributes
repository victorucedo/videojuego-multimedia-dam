# Normaliza los saltos de línea (evita conflictos Windows / otros)
* text=auto

# Archivos de Unity en texto: tratarlos como texto
*.cs        text diff=csharp
*.shader    text
*.json      text
*.md        text

# Escenas, prefabs y assets serializados de Unity (YAML)
*.unity     text merge=unityyamlmerge eol=lf
*.prefab    text merge=unityyamlmerge eol=lf
*.asset     text merge=unityyamlmerge eol=lf
*.mat       text merge=unityyamlmerge eol=lf
*.anim      text merge=unityyamlmerge eol=lf
*.controller text merge=unityyamlmerge eol=lf
*.meta      text eol=lf

# Archivos binarios (no intentar hacer diff ni merge)
*.png   binary
*.jpg   binary
*.psd   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.fbx   binary
*.ttf   binary
